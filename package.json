{
  "name": "backends-sdk",
  "version": "0.1.1",
  "description": "Minimal client + server SDK for backends auth (project-scoped end users).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "AGENTS.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "prepare": "tsup"
  },
  "keywords": ["backends", "auth", "sdk", "authentication"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roykang75/backends_sdk.git"
  },
  "homepage": "https://github.com/roykang75/backends_sdk#readme",
  "bugs": { "url": "https://github.com/roykang75/backends_sdk/issues" },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
